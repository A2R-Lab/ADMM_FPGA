#include "ADMM.h"
static fp_t zx[N_VAR],zb[N_VAR],zy[N_CONSTR];
extern "C" void reset(){
 for(int i=0;i<N_VAR;i++){zx[i]=0;zb[i]=0;}
 for(int i=0;i<N_CONSTR;i++)zy[i]=0;
}
extern "C" void control(const double* state,const double* ref,double* u){
const double weights[12]={@WEIGHTS@};

 fp_t x[12],q[N_VAR];
 for(int i=0;i<12;i++)x[i]=state[i];
 for(int i=0;i<N_VAR;i++)q[i]=0;
 for(int k=0;k<=HORIZON_LENGTH;k++)for(int i=0;i<12;i++)q[k*16+i]=-ref[k*12+i]*weights[i];
 for(int i=0;i<ADMM_ITERATIONS;i++)ADMM_iteration(zx,zb,zy,x,false,0,(fp_t)XY_MIN,(fp_t)XY_MAX,q,true);
 for(int i=0;i<4;i++)u[i]=double(zx[12+i]);
}
